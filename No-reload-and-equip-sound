--// .Zoewar MM2 Script (UI Cápsula, Tecla 'E' para PC, Suporte PC e Mobile)

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local enabled = false

-- Criar ScreenGui
local gui = Instance.new("ScreenGui")
gui.Name = "zoewar"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

-- Fundo estilo cápsula com fundo transparente
local main = Instance.new("Frame")
main.Parent = gui
main.Size = UDim2.new(0, 135, 0, 32)
main.Position = UDim2.new(0.5, -67, 0.75, 0)
main.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
main.BackgroundTransparency = 0.5
main.BorderSizePixel = 0

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(1, 0)
corner.Parent = main

-- Texto (".zoewar") à esquerda
local title = Instance.new("TextLabel")
title.Parent = main
title.BackgroundTransparency = 1
title.Size = UDim2.new(0.55, 0, 1, 0)
title.Position = UDim2.new(0, 10, 0, 0)
title.Font = Enum.Font.GothamBold
title.Text = ".zoewar"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextScaled = true
title.TextXAlignment = Enum.TextXAlignment.Left

-- Botão ON/OFF à direita em formato de pílula
local toggle = Instance.new("TextButton")
toggle.Parent = main
toggle.Size = UDim2.new(0, 42, 0, 22)
toggle.Position = UDim2.new(1, -50, 0.5, -11)
toggle.Font = Enum.Font.GothamBold
toggle.TextScaled = true
toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
toggle.BorderSizePixel = 0

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(1, 0)
toggleCorner.Parent = toggle

-- Configuração do Som de Equipar/Desequipar
local equipSound = Instance.new("Sound")
equipSound.Name = "ZoewarEquipSound"
equipSound.SoundId = "rbxassetid://12221976" -- Som clássico
equipSound.Volume = 0.5
equipSound.Parent = SoundService

-- Função para atualizar visual do botão
local function updateUI()
	if enabled then
		title.Text = ".Zoewar ON"
		title.TextColor3 = Color3.fromRGB(0, 255, 128)
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
	else
		title.Text = ".Zoewar OFF"
		title.TextColor3 = Color3.fromRGB(255, 75, 75)
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	end
end

-- Função para alternar o estado (ON/OFF)
local function toggleState()
	enabled = not enabled
	updateUI()
	equipSound:Play()
end

-- Lógica para remover recarga/recuo da arma
local function applyGunMod(tool)
	if tool:IsA("Tool") and tool:FindFirstChild("GunScript") then
		-- Modifica os atributos se a ferramenta for a pistola do MM2
		task.spawn(function()
			local gunScript = tool:FindFirstChild("GunScript")
			if gunScript then
				-- Tenta modificar os valores de Delay/Cooldown na arma se existirem
				for _, v in pairs(tool:GetDescendants()) do
					if v:IsA("NumberValue") or v:IsA("IntValue") then
						if v.Name:lower():find("cooldown") or v.Name:lower():find("delay") or v.Name:lower():find("reload") then
							v.Value = 0
						end
					end
				end
			end
		end)
	end
end

-- Monitorar quando o jogador pega um item
local function setup(char)
	char.ChildAdded:Connect(function(child)
		if enabled then
			applyGunMod(child)
		end
	end)
end

if player.Character then
	setup(player.Character)
end

player.CharacterAdded:Connect(setup)

-- Ação ao clicar no botão ON/OFF (Compatível PC/Mobile)
toggle.Activated:Connect(function()
	toggleState()
end)

-- Atalho com a Tecla "E" (Apenas PC, ignorando se estiver digitando no chat)
UIS.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
		toggleState()
	end
end)

-- Inicializa o estado visual da interface
updateUI()
