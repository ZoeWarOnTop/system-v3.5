-- Configuração do Som de Equipar
local equipSound = Instance.new("Sound")
equipSound.Name = "ZoewarEquipSound"
equipSound.SoundId = OLD_SOUND_ID
equipSound.Volume = 1
equipSound.Parent = SoundService

--// Função para identificar se é uma arma do MM2 (Gingerscope e outras)
local function isGun(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local nameLower = tool.Name:lower()
    if nameLower:find("gun") or nameLower:find("sheriff") or nameLower:find("revolver") or nameLower:find("pistol") or nameLower:find("gingerscope") or nameLower:find("blaster") then
        return true
    end
    if tool:FindFirstChild("Handle") and (tool:FindFirstChild("Shoot") or tool:FindFirstChild("ServerSpew") or tool:FindFirstChild("ClientAmmo")) then
        return true
    end
    return false
end

--// Atualizar o visual do botão ON/OFF
local function updateUI()
	if enabled then
		title.Text = "zoewar🎃🕸"
		title.TextColor3 = Color3.fromRGB(255, 170, 70)

		toggle.Text = "ON"  
		toggle.BackgroundColor3 = Color3.fromRGB(255, 120, 20)  
	else  
		title.Text = "zoewar🎃🕸"  
		title.TextColor3 = Color3.fromRGB(255, 170, 70)  

		toggle.Text = "OFF"  
		toggle.BackgroundColor3 = Color3.fromRGB(150, 55, 0)  
	end
end

--// Alternar Estado
local function toggleState()
	enabled = not enabled
	updateUI()
end

--// Bloqueio de animações indesejadas (Recarga e Recuo/Disparo)
local function setup(character)
	local humanoid = character:WaitForChild("Humanoid")
	local animator = humanoid:WaitForChild("Animator")

	if connection then
		connection:Disconnect()
	end

	connection = animator.AnimationPlayed:Connect(function(track)
		if enabled then
			local animId = track.Animation and track.Animation.AnimationId or ""
			local nameLower = track.Name:lower()
			
			if animId:find("558601175") or nameLower:find("reload") or nameLower:find("shoot") or nameLower:find("fire") or nameLower:find("recoil") or nameLower:find("kick") then
				track:Stop()
			end
		end
	end)

	character.ChildAdded:Connect(function(child)
		if enabled and isGun(child) then
			equipSound:Play()
		end
	end)

	character.ChildRemoved:Connect(function(child)
		if enabled and isGun(child) then
			equipSound:Play()
		end
	end)
end

if player.Character then
	setup(player.Character)
end

player.CharacterAdded:Connect(setup)

-- Ação ao clicar no botão ON/OFF (Compatível PC/Mobile)
toggle.Activated:Connect(function()
	toggleState()
end)

--// Atalho com a Tecla "E" (Apenas PC, ignorando se estiver digitando no chat)
UIS.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
		toggleState()
	end
end)

updateUI()

--// SISTEMA DE ARRASTAR COMPATÍVEL COM PC E MOBILE
local dragging = false
local dragStart = nil
local startPos = nil

local function updateDrag(input)
	local delta = input.Position - dragStart

	main.Position = UDim2.new(
		startPos.X.Scale,
		startPos.X.Offset + delta.X,
		startPos.Y.Scale,
		startPos.Y.Offset + delta.Y
	)
end

main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = main.Position

		local conn
		conn = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				if conn then
					conn:Disconnect()
				end
			end
		end)
	end
end)

main.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
	or input.UserInputType == Enum.UserInputType.Touch then
		if dragging then
			updateDrag(input)
		end
	end
end)
