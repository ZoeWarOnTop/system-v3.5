--// _zoew4r MM2 Script
--// UI based on _thurs4x GUI

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer

local enabled = false
local connection

local OLD_SOUND_ID = "rbxassetid://6968135315"

--// GUI
local gui = Instance.new("ScreenGui")
gui.Name = "_zoew4r"
gui.Parent = game.CoreGui
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false

local frame = Instance.new("Frame")
frame.Parent = gui
frame.Size = UDim2.new(0, 120, 0, 28)
frame.Position = UDim2.new(0.72, 0, 0.08, 0)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
frame.BackgroundTransparency = 0.15
frame.Active = true
frame.Draggable = true

local corner = Instance.new("UICorner")
corner.Parent = frame
corner.CornerRadius = UDim.new(1, 0)

local stroke = Instance.new("UIStroke")
stroke.Parent = frame
stroke.Color = Color3.fromRGB(255, 255, 255)
stroke.Transparency = 0.7
stroke.Thickness = 1

--// Glass / iOS style gradient
local gradient = Instance.new("UIGradient")
gradient.Parent = frame
gradient.Color = ColorSequence.new{
	ColorSequenceKeypoint.new(0, Color3.fromRGB(35, 35, 35)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(15, 15, 15))
}

--// Title
local title = Instance.new("TextLabel")
title.Parent = frame
title.BackgroundTransparency = 1
title.Position = UDim2.new(0.06, 0, 0, 0)
title.Size = UDim2.new(0, 60, 1, 0)
title.Font = Enum.Font.GothamBold
title.Text = "_zoew4r"
title.TextScaled = true
title.TextColor3 = Color3.fromRGB(255, 255, 255)

--// Toggle button
local toggle = Instance.new("TextButton")
toggle.Parent = frame
toggle.Size = UDim2.new(0, 40, 0, 18)
toggle.Position = UDim2.new(0.63, 0, 0.18, 0)
toggle.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
toggle.Font = Enum.Font.GothamBold
toggle.Text = "OFF"
toggle.TextScaled = true
toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
toggle.BorderSizePixel = 0

local toggleCorner = Instance.new("UICorner")
toggleCorner.Parent = toggle
toggleCorner.CornerRadius = UDim.new(1, 0)

--// Equip / Unequip sound
local equipSound = Instance.new("Sound")
equipSound.Name = "ZoewarEquipSound"
equipSound.SoundId = OLD_SOUND_ID
equipSound.Volume = 1
equipSound.Parent = SoundService

--// Identify MM2 guns
local function isGun(tool)
	if not tool or not tool:IsA("Tool") then
		return false
	end

	local nameLower = tool.Name:lower()

	if nameLower:find("gun")
		or nameLower:find("sheriff")
		or nameLower:find("revolver")
		or nameLower:find("pistol")
		or nameLower:find("gingerscope")
		or nameLower:find("blaster") then
		return true
	end

	if tool:FindFirstChild("Handle")
		and (
			tool:FindFirstChild("Shoot")
			or tool:FindFirstChild("ServerSpew")
			or tool:FindFirstChild("ClientAmmo")
		) then
		return true
	end

	return false
end

--// Update UI
local function updateUI()
	if enabled then
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
	else
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
	end
end

--// Toggle state
local function toggleState()
	enabled = not enabled
	updateUI()
end

--// Animation blocking
local function setup(character)
	local humanoid = character:WaitForChild("Humanoid")
	local animator = humanoid:WaitForChild("Animator")

	if connection then
		connection:Disconnect()
	end

	connection = animator.AnimationPlayed:Connect(function(track)
		if enabled then
			local animId = track.Animation and track.Animation.AnimationId or ""
			local nameLower = track.Name:lower()

			if animId:find("558601175")
				or nameLower:find("reload")
				or nameLower:find("shoot")
				or nameLower:find("fire")
				or nameLower:find("recoil")
				or nameLower:find("kick") then

				track:Stop()
			end
		end
	end)

	character.ChildAdded:Connect(function(child)
		if enabled and isGun(child) then
			equipSound:Play()
		end
	end)

	character.ChildRemoved:Connect(function(child)
		if enabled and isGun(child) then
			equipSound:Play()
		end
	end)
end

if player.Character then
	setup(player.Character)
end

player.CharacterAdded:Connect(setup)

--// Toggle button
toggle.Activated:Connect(function()
	toggleState()
end)

--// E key toggle
UIS.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
		toggleState()
	end
end)

updateUI()
